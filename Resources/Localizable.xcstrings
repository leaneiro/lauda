    "A single Return doesn't break the line, as in standard Markdown." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Enter sozinho não quebra a linha, como no Markdown padrão."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein einzelnes Return erzeugt keinen Zeilenumbruch, wie in Standard-Markdown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un solo Retorno no divide la línea, como en Markdown estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un simple retour ne crée pas de saut de ligne, comme en Markdown standard."
